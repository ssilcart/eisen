    "build": "bun build --compile src/main.ts --outfile dist/eisen"
  },
  "dependencies": {
    "@opentui/core": "0.8.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
